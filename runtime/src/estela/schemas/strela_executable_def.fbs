namespace iree.hal.strela;

// 'STRELA v1 Executable'.
file_identifier "STR1";
file_extension "str1";

// immediate value, or constants[value] when is_constant
struct ValueDef { value:uint32; is_constant:bool; }

// Parameters of min(d * step, limit) where d in {x,y,z}
struct WorkgroupTermDef { step:ValueDef; limit:ValueDef; }

// Bytes from the start of the binding:
//   offset + sum(min(d * step, limit) for d in {x,y,z})
// d is the workgroup id along that dimension, known only at dispatch
table AddressDef {
  binding:uint32;
  offset:ValueDef (required);
  workgroup_x:WorkgroupTermDef (required);
  workgroup_y:WorkgroupTermDef (required);
  workgroup_z:WorkgroupTermDef (required);
}

table InputColumnDef  {
  address:AddressDef (required);
  word_count:ValueDef (required);
  word_stride:ValueDef (required);
}

table OutputColumnDef {
  address:AddressDef (required);
  word_count:ValueDef (required);
}

table ExportDef {
  name:string (required); // The name hal.executable.lookup.function asks for.

  bitstream:[uint32] (required);        // The configuration bitstream
  inputs:[InputColumnDef] (required);   // Exactly four.
  outputs:[OutputColumnDef] (required); // Exactly four.

  // In the .dispatch member of iree_hal_command_buffer_vtable_t two arguments
  // are arrays of unknown size.
  constant_count:uint32; // sizes iree_const_byte_span_t constants
  binding_count:uint32;  // sizes iree_hal_buffer_ref_list_t bindings
}

table ExecutableDef {
  exports:[ExportDef] (required); // Linking stitches many executables together
}

root_type ExecutableDef;
